# Sanity — create a free project at sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# Cloudinary — console.cloudinary.com
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME is required for next-cloudinary (CldImage, delivery URLs).
# CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET are used by the media-cleanup cron only (Admin API).
# Studio uploads use cloud name + API key configured once in /studio via the Cloudinary plugin UI
# (stored in Sanity as a private secrets document — API secret is NOT entered in Studio).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mux — dashboard.mux.com → Settings → API Access Tokens
# Used ONLY by the media-cleanup cron (server-side asset delete).
# Studio uploads use a separate token configured in /studio → Videos → Configure plugin
# (stored in Sanity as secrets.mux — not in env vars).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Vercel Cron — set in Vercel dashboard; sent as Authorization: Bearer header
CRON_SECRET=

# Resend — resend.com (contact form)
# CONTACT_FROM_EMAIL requires a verified domain in Resend. Leave it empty and
# the form falls back to onboarding@resend.dev, which ONLY delivers to the
# email that owns the Resend account — fine for testing, not for production.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Site URL (optional — used for sitemap/robots and JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
